{
  "env": {
    "HERDR_ENV": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Skill(update-config)",
      "Bash(herdr *)",
      "Bash(jq *)",
      "Bash(python3 -c ' *)",
      "Bash(git --version)",
      "Bash(git fetch *)",
      "Bash(backlog --version)",
      "Bash(backlog task *)",
      "Bash(backlog doc *)",
      "Bash(backlog search *)",
      "Bash(backlog instructions *)",
      "Bash(backlog schedule *)",
      "Bash(npx backlog *)",
      "WebSearch"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/k.koshi/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "theme": "dark"
}
