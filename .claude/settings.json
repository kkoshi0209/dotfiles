{
  "env": {
    "HERDR_ENV": "1"
  },
  "permissions": {
    "allow": [
      "Skill(update-config)",
      "Bash(herdr *)",
      "Bash(jq *)",
      "Bash(python3 -c ' *)",
      "Bash(git --version)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git worktree list)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(uuidgen)",
      "Bash(* --version)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(backlog --version)",
      "Bash(backlog task *)",
      "Bash(backlog doc *)",
      "Bash(backlog search *)",
      "Bash(backlog instructions *)",
      "Bash(backlog schedule *)",
      "Bash(npx backlog *)",
      "WebSearch"
    ],
    "deny": [
      "Bash(herdr server stop*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/k.koshi/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/k.koshi/.claude/hooks/check-mermaid-br.py'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true
}
