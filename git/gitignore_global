# ==================================================================
# グローバル gitignore
#   「どのプロジェクトでも絶対に追跡しないもの」だけを書く。
#   プロジェクト固有の除外は各リポジトリの .gitignore に置く。
# ==================================================================

# ------------------------------------------------------------------
# macOS
# ------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon?

# ------------------------------------------------------------------
# エディタ / IDE
# ------------------------------------------------------------------
# VS Code: プロジェクト共有する設定だけ通す
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# JetBrains
.idea/
*.iml

# Vim / Emacs
*~
*.swp
*.swo
.\#*
\#*\#

# ------------------------------------------------------------------
# Claude Code
# ------------------------------------------------------------------
**/.claude/settings.local.json
**/.claude/.cc-writes/

# ------------------------------------------------------------------
# 秘密情報・ローカル専用
#   誤コミットの最後の砦。プロジェクト側にも書くこと。
# ------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
.direnv/
.envrc.local

# ------------------------------------------------------------------
# 各種ツールが吐くローカルの作業ファイル
# ------------------------------------------------------------------
# ctags
tags
TAGS

# Terraform（ローカル state / プラン結果）
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Ruby
.byebug_history
.ruby-gemset

# Node
.npm/
.yarn/cache
.node_repl_history

# 汎用
*.log
*.bak
*.orig
*.rej
