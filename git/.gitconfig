# 各設定の理由は dotfiles/docs/settings.md「git/.gitconfig」を参照
[user]
	name = kkoshi0209
	email = doradorayuji@gmail.com

[core]
	excludesfile = ~/.config/git/ignore
	quotepath = false
	precomposeunicode = true
	untrackedCache = true

[init]
	defaultBranch = main

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[pull]
	rebase = false

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true
	autoupdate = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[commit]
	verbose = true

[help]
	autocorrect = prompt

[status]
	showUntrackedFiles = all

[log]
	date = iso

[color]
	ui = auto

[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch
	ci = commit
	ca = commit --amend
	amend = commit --amend --no-edit
	unstage = restore --staged
	last = log -1 HEAD --stat
	lg = log --graph --abbrev-commit --date=relative \
		--format=format:'%C(bold blue)%h%C(reset) %C(dim white)%ar%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)'
	undo = reset --soft HEAD~1
	pushf = push --force-with-lease
	current = rev-parse --abbrev-ref HEAD
	merged = branch --merged
	aliases = config --get-regexp ^alias\\.

[include]
	path = ~/.gitconfig.local

[http]
	version = HTTP/2
